# ── Copy this file to `.env` (same folder) and fill in your key ──────────────
# The backend loads this automatically on startup (python-dotenv).

# Anthropic API key — used ONLY for the discrepancy-analysis feedback report.
# Everything else (upload, processing, labeling, comparison) works without it.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# Model used for the feedback report (never in the per-frame vision loop).
ANTHROPIC_MODEL=claude-opus-4-8

# ── Optional ─────────────────────────────────────────────────────────────────
# Inference device: auto | xpu | cuda | cpu   (auto picks xpu → cuda → cpu)
CV_DEVICE=auto

# Hardware profile: bundles the per-GPU speed knobs (device, precision,
# OpenVINO on/off, TrackNet on/off, Pass 1 subsampling) into one name, so each
# machine gets inference tuned for ITS OWN speed — not for matching another
# machine's output. See backend/app/hw_profiles.json for the available names
# (add your own machine there; no code change needed). Leave unset to keep
# today's plain CV_DEVICE/TRACKNET_ENABLED/PASS2_BALL behavior unchanged.
# HW_PROFILE=cuda

# Where uploaded videos + the SQLite DB live (default: ./data next to backend)
# DATA_DIR=c:\Projects\CV Testing System\data

# Path to TrackNet ball-tracker weights (see README §Ball tracking weights).
# Leave unset until you have weights; the system falls back to the classical
# ball detector and logs a warning.
# TRACKNET_WEIGHTS=c:\Projects\CV Testing System\weights\tracknet_v2.pt
